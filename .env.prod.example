# Copy this to `.env` next to docker-compose.prod.yml on the EC2 instance
# and fill in real values - see DEPLOY.md for the full walkthrough.

# Any strong password - this is Postgres's own login, not exposed outside
# the Docker network.
POSTGRES_PASSWORD=replace_me

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_with_a_random_64_char_hex_string

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Your EC2 instance's public IP or domain, exactly as the browser will load
# the frontend from - needed for CORS (the backend only accepts requests
# from this origin) and for the refresh-token cookie's domain matching.
FRONTEND_URL=http://YOUR_EC2_PUBLIC_IP

# Where the frontend's JS calls the backend - same host, backend's port.
# Baked into the frontend build at build time (see frontend/Dockerfile),
# so changing this requires rebuilding the frontend image, not just
# restarting the container.
VITE_API_URL=http://YOUR_EC2_PUBLIC_IP:4000
