// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  DEVELOPER
  VIEWER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  users           User[]
  projects        Project[]
  tasks           Task[]
  taskDependencies TaskDependency[]
  comments        Comment[]
  notifications   Notification[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           Role     @default(DEVELOPER)
  // Fixed for now (no edit UI yet) - just enough for the workload view to
  // compare against. See docs/phase-7-workload-notifications.md.
  weeklyCapacityHours Int  @default(40)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  assignedTasks       Task[]
  comments            Comment[]
  notifications       Notification[]

  @@index([organizationId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  tasks        Task[]

  @@index([organizationId])
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  status         TaskStatus @default(TODO)
  // Bumped on every update. A write must present the version it read; a
  // mismatch means someone else changed the row in between (see
  // docs/phase-5-optimistic-concurrency.md).
  version        Int        @default(1)
  // Optional - not every task needs an estimate. Feeds the workload view's
  // aggregation (docs/phase-7-workload-notifications.md).
  estimatedHours Float?
  organizationId String
  projectId      String
  assigneeId     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project      @relation(fields: [projectId], references: [id])
  assignee     User?        @relation(fields: [assigneeId], references: [id])

  // "outgoing" = this task is the source of the edge (it blocks / duplicates
  // / relates-to the other task). "incoming" = this task is the target (it
  // is blocked by / is duplicated by / is related-to-by the other task).
  outgoingDependencies TaskDependency[] @relation("DependencySource")
  incomingDependencies TaskDependency[] @relation("DependencyTarget")
  comments             Comment[]
  notifications        Notification[]

  @@index([organizationId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

model Comment {
  id             String   @id @default(cuid())
  body           String
  taskId         String
  authorId       String
  organizationId String
  createdAt      DateTime @default(now())

  task         Task         @relation(fields: [taskId], references: [id])
  author       User         @relation(fields: [authorId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([taskId])
  @@index([organizationId])
}

enum NotificationType {
  TASK_ASSIGNED
  NEW_COMMENT
}

// Written by the notification WORKER (see backend/src/queue/), not directly
// by the request handler that triggers it - that's the whole point of
// routing this through a queue instead of writing it inline.
model Notification {
  id             String           @id @default(cuid())
  type           NotificationType
  message        String
  read           Boolean          @default(false)
  userId         String
  organizationId String
  taskId         String?
  createdAt      DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  task         Task?        @relation(fields: [taskId], references: [id])

  @@index([userId])
  @@index([organizationId])
}

enum DependencyType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}

// Only three stored types, not four: BLOCKS and BLOCKED_BY are the same fact
// viewed from opposite ends, so the API translates BLOCKED_BY into a BLOCKS
// edge pointing the other way rather than storing both directions separately.
model TaskDependency {
  id             String         @id @default(cuid())
  type           DependencyType
  organizationId String
  taskId         String
  relatedTaskId  String
  createdAt      DateTime       @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  task         Task         @relation("DependencySource", fields: [taskId], references: [id])
  relatedTask  Task         @relation("DependencyTarget", fields: [relatedTaskId], references: [id])

  @@unique([taskId, relatedTaskId, type])
  @@index([organizationId])
  @@index([taskId])
  @@index([relatedTaskId])
}

// The refresh token itself is never stored in plain form - only a hash of it,
// the same way a password is. If the DB leaked, the tokens in it would be
// useless without the original random value the client holds.
model RefreshToken {
  id                  String    @id @default(cuid())
  tokenHash           String    @unique
  userId              String
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}
