// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  DEVELOPER
  VIEWER
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  users           User[]
  projects        Project[]
  tasks           Task[]
  taskDependencies TaskDependency[]
  comments        Comment[]
  notifications   Notification[]
  attachments     Attachment[]
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           Role     @default(DEVELOPER)
  // Fixed for now (no edit UI yet) - just enough for the workload view to
  // compare against. See docs/phase-7-workload-notifications.md.
  weeklyCapacityHours Int  @default(40)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization       Organization        @relation(fields: [organizationId], references: [id])
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  assignedTasks       Task[]
  reportedTasks       Task[]              @relation("TaskReporter")
  comments            Comment[]
  notifications       Notification[]
  uploadedAttachments Attachment[]

  @@index([organizationId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IssueType {
  TASK
  BUG
  STORY
  EPIC
}

model Project {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  tasks        Task[]

  @@index([organizationId])
}

model Task {
  id             String     @id @default(cuid())
  title          String
  description    String?
  // What "done" means for this task - shown on every task regardless of
  // type. Free text rather than a checklist: no requirement yet that each
  // criterion be individually checked off.
  acceptanceCriteria String?
  // Bug-only fields (hidden in the UI unless issueType is BUG). Kept as
  // plain nullable columns rather than a separate BugDetails table - a
  // second table would only earn its keep if bugs needed their own
  // relations or independent lifecycle, and they don't.
  stepsToReproduce   String?
  expectedResult     String?
  actualResult       String?
  status         TaskStatus @default(TODO)
  priority       Priority   @default(MEDIUM)
  issueType      IssueType  @default(TASK)
  // Date-only in the UI, but stored as a full DateTime - Postgres has no
  // separate "date" type Prisma maps to something simpler here, and there's
  // no need for one since this is never compared at sub-day precision.
  dueDate        DateTime?
  // Free-form tags (e.g. "frontend", "urgent"). A native Postgres array
  // column, not a join table - there's no cross-task label management
  // (rename a label everywhere, list all labels org-wide) that would justify
  // a normalized Label model, just per-task text.
  labels         String[]   @default([])
  // Bumped on every update. A write must present the version it read; a
  // mismatch means someone else changed the row in between (see
  // docs/phase-5-optimistic-concurrency.md).
  version        Int        @default(1)
  // Optional - not every task needs an estimate. Feeds the workload view's
  // aggregation (docs/phase-7-workload-notifications.md).
  estimatedHours Float?
  organizationId String
  projectId      String
  assigneeId     String?
  // Who originally created the task - set once, at creation, from the
  // authenticated caller, and never taken from client input (a Manager
  // can't create a task "as" someone else). Nullable only because tasks
  // created before this field existed have none.
  reporterId     String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  project      Project      @relation(fields: [projectId], references: [id])
  assignee     User?        @relation(fields: [assigneeId], references: [id])
  reporter     User?        @relation("TaskReporter", fields: [reporterId], references: [id])

  // "outgoing" = this task is the source of the edge (it blocks / duplicates
  // / relates-to the other task). "incoming" = this task is the target (it
  // is blocked by / is duplicated by / is related-to-by the other task).
  outgoingDependencies TaskDependency[] @relation("DependencySource")
  incomingDependencies TaskDependency[] @relation("DependencyTarget")
  comments             Comment[]
  notifications        Notification[]
  attachments          Attachment[]

  @@index([organizationId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([status])
}

model Comment {
  id             String   @id @default(cuid())
  body           String
  taskId         String
  authorId       String
  organizationId String
  createdAt      DateTime @default(now())

  // Deleting a task takes its comments with it - a comment has no meaning
  // once the thing it's commenting on is gone. (This is also what fixes
  // task deletion previously failing outright whenever a task had any
  // comments at all - the default is RESTRICT, not cascade.)
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author       User         @relation(fields: [authorId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([taskId])
  @@index([organizationId])
}

// Files themselves live on disk (backend/uploads/, see src/lib/storage.ts) -
// this row is only the metadata. `storedName` is the randomly generated
// on-disk filename (collision-proof, no path-traversal risk from a user's
// original filename); `filename` is the original name shown/downloaded-as.
model Attachment {
  id             String   @id @default(cuid())
  filename       String
  storedName     String   @unique
  mimeType       String
  size           Int
  taskId         String
  uploadedById   String
  organizationId String
  createdAt      DateTime @default(now())

  // The DB row cascades with the task; the physical file on disk does not
  // (Postgres has no idea backend/uploads/ exists) - the task-delete route
  // deletes those files itself before removing the task.
  task         Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([taskId])
  @@index([organizationId])
}

enum NotificationType {
  TASK_ASSIGNED
  NEW_COMMENT
}

// Written by the notification WORKER (see backend/src/queue/), not directly
// by the request handler that triggers it - that's the whole point of
// routing this through a queue instead of writing it inline.
model Notification {
  id             String           @id @default(cuid())
  type           NotificationType
  message        String
  read           Boolean          @default(false)
  userId         String
  organizationId String
  taskId         String?
  createdAt      DateTime         @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  // Unlike Comment/Attachment, a notification isn't really "about" the
  // task's continued existence - it's a historical record ("you were
  // assigned to X"). Deleting the task detaches the link (taskId was
  // already optional) rather than deleting someone's notification history.
  task         Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([organizationId])
}

enum DependencyType {
  BLOCKS
  RELATES_TO
  DUPLICATES
}

// Only three stored types, not four: BLOCKS and BLOCKED_BY are the same fact
// viewed from opposite ends, so the API translates BLOCKED_BY into a BLOCKS
// edge pointing the other way rather than storing both directions separately.
model TaskDependency {
  id             String         @id @default(cuid())
  type           DependencyType
  organizationId String
  taskId         String
  relatedTaskId  String
  createdAt      DateTime       @default(now())

  // Deleting either side of a dependency link takes the link with it - a
  // "blocks"/"relates to"/"duplicates" edge referencing a task that no
  // longer exists isn't a link worth keeping.
  organization Organization @relation(fields: [organizationId], references: [id])
  task         Task         @relation("DependencySource", fields: [taskId], references: [id], onDelete: Cascade)
  relatedTask  Task         @relation("DependencyTarget", fields: [relatedTaskId], references: [id], onDelete: Cascade)

  @@unique([taskId, relatedTaskId, type])
  @@index([organizationId])
  @@index([taskId])
  @@index([relatedTaskId])
}

// The refresh token itself is never stored in plain form - only a hash of it,
// the same way a password is. If the DB leaked, the tokens in it would be
// useless without the original random value the client holds.
model RefreshToken {
  id                  String    @id @default(cuid())
  tokenHash           String    @unique
  userId              String
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedByTokenHash String?
  createdAt           DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}
